# Copie este archivo como .env y cambie las claves:   cp .env.example .env
# .env nunca va a Git (está en .gitignore). Las imágenes no contienen credenciales.

# Base de datos del producto (PostgreSQL propio, separado del de Airflow)
PRODUCTO_DB_USUARIO=novamercado
PRODUCTO_DB_CLAVE=cambie_esta_clave
PRODUCTO_DB_NOMBRE=novamercado

# Base de datos de Airflow
AIRFLOW_DB_USUARIO=airflow
AIRFLOW_DB_CLAVE=cambie_esta_otra_clave

# Usuario de Airflow: interfaz en http://localhost:8080 y API que usa /admin/reentrenar
AIRFLOW_USUARIO=admin
AIRFLOW_CLAVE=cambie_la_clave_de_airflow

# Secreto con que Airflow firma sus tokens (cualquier texto largo y aleatorio)
AIRFLOW_JWT_SECRET=cambie_este_secreto_por_uno_largo_y_aleatorio

# Opcional: clave Fernet de Airflow para cifrar conexiones (vacía = sin cifrado)
AIRFLOW_FERNET_KEY=

# Opcional, solo para ensayos: carga el histórico solo hasta esta fecha (AAAA-MM-DD) para
# reproducir los días siguientes con scripts/simular_operacion.py. Vacío = histórico completo.
HISTORICO_HASTA=
